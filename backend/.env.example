APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./backend/hydroinsight.db
APP_BASE_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DEVICE_INGEST_KEY=local-device-key
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SEED_DEMO=false
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
EMAIL_PROVIDER=development
EMAIL_FROM=AquaSense AI <no-reply@example.local>
SMS_PROVIDER=development
SMS_FROM=AquaSense AI
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_MB=10
STALE_MEASUREMENT_HOURS=24
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=12
RATE_LIMIT_INGEST_REQUESTS=120
SCHEMA_AUTO_CREATE=true

