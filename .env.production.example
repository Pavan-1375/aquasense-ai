# Copy to .env locally or configure these in your hosting provider's secret store.
# Never commit the populated file. Generate values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
SECRET_KEY=generate-a-long-random-value
DEVICE_INGEST_KEY=generate-a-separate-device-key
APP_BASE_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
POSTGRES_PASSWORD=generate-a-strong-database-password
DATABASE_URL=postgresql+psycopg://aquasense:${POSTGRES_PASSWORD}@db:5432/aquasense
SCHEMA_AUTO_CREATE=false
SCHEDULER_ENABLED=true

# Email delivery: SMTP is provider-neutral and can use a free-tier transactional provider.
EMAIL_PROVIDER=smtp
EMAIL_FROM=AquaSense AI <no-reply@your-domain.example>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true

VITE_API_URL=https://api.your-domain.example
