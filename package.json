{
  "name": "hydroinsight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev-stack.ps1 -OpenBrowser",
    "dev:frontend": "vite",
    "dev:stack": "powershell -ExecutionPolicy Bypass -File scripts/dev-stack.ps1",
    "stop:stack": "powershell -ExecutionPolicy Bypass -File scripts/stop-stack.ps1",
    "enable:auto-publish": "powershell -ExecutionPolicy Bypass -File scripts/enable-auto-publish.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "publish": "powershell -ExecutionPolicy Bypass -File scripts/publish.ps1"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "6.1.2",
    "leaflet": "^1.9.4",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
